{
  "expo": {
    "name": "IE - intercultural experience",
    "slug": "ieapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intercultural.experience",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Usamos tu galería para que puedas seleccionar y subir tu foto de perfil y los documentos requeridos en tu proceso de admisión."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.intercultural.experience",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tu galería para que puedas seleccionar y subir tu foto de perfil y los documentos requeridos en tu proceso de admisión.",
          "cameraPermission": "La app puede usar la cámara solo si elegís sacar una foto para tu perfil o tus documentos.",
          "microphonePermission": false
        }
      ],
      "./plugins/withPhoneOnlyScreens"
    ],
    "extra": {
      "eas": {
        "projectId": "26b85eae-a04e-45c4-9804-30e777367a99"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/26b85eae-a04e-45c4-9804-30e777367a99"
    }
  }
}
